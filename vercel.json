{
  "version": 2,
  "functions": {
    "api/*.js": {
      "runtime": "nodejs20.x",
      "memory": 512,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/api/pair-code", "destination": "/api/pair-code" },
    { "source": "/health", "destination": "/api/health" }
  ]
}
